{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "38rem",
			"wideSize": "60rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": true,
			"palette": [
				{ "slug": "paper",     "color": "#f3eee3", "name": "Paper" },
				{ "slug": "paper-2",   "color": "#ece5d4", "name": "Old paper" },
				{ "slug": "paper-3",   "color": "#e3dac3", "name": "Archival fold" },
				{ "slug": "ink",       "color": "#1a1714", "name": "Ink" },
				{ "slug": "ink-muted", "color": "#6a615a", "name": "Graphite" },
				{ "slug": "rule",      "color": "#c9bfa9", "name": "Pencil rule" },
				{ "slug": "accent",    "color": "#8a1a1a", "name": "Dark red" },
				{ "slug": "accent-2",  "color": "#5e1010", "name": "Burnt red" },
				{ "slug": "mark",      "color": "#f7e7c5", "name": "Highlighter" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "serif", "name": "Serif",     "fontFamily": "\"EB Garamond\", Georgia, \"Times New Roman\", serif" },
				{ "slug": "sans",  "name": "Sans",      "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, sans-serif" },
				{ "slug": "mono",  "name": "Monospace", "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace" }
			],
			"fontSizes": [
				{ "slug": "xs",   "size": "0.78rem",   "name": "Marginal" },
				{ "slug": "sm",   "size": "0.875rem",  "name": "Caption" },
				{ "slug": "base", "size": "1.0625rem", "name": "Body" },
				{ "slug": "md",   "size": "1.1875rem", "name": "Lede" },
				{ "slug": "lg",   "size": "1.5rem",    "name": "Subhead" },
				{ "slug": "xl",   "size": "2rem",      "name": "Headline" },
				{ "slug": "2xl",  "size": "2.75rem",   "name": "Display" },
				{ "slug": "3xl",  "size": "3.75rem",   "name": "Masthead" }
			],
			"dropCap": true,
			"customFontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "%", "vh", "vw"]
		},
		"border": { "color": true, "style": true, "width": true, "radius": false }
	},
	"styles": {
		"color":      { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "lineHeight": "1.65" },
		"elements": {
			"link":   { "color": { "text": "var(--wp--preset--color--accent)" } },
			"h1":     { "typography": { "fontWeight": "500", "letterSpacing": "-0.01em" } },
			"h2":     { "typography": { "fontWeight": "500", "letterSpacing": "-0.01em" } },
			"button": {
				"color":     { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
				"typography":{ "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.78rem", "textTransform": "uppercase", "letterSpacing": "0.12em" }
			}
		}
	}
}
